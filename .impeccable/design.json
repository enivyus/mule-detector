  "components": [
    {
      "name": "Default Button",
      "kind": "button",
      "refersTo": "button-default",
      "description": "Secondary actions: refresh, cancel, unfreeze in compact rows.",
      "html": "<button class=\"ds-btn\">Refresh</button>",
      "css": ".ds-btn { font-family: var(--font); font-size: 13px; font-weight: 500; line-height: 20px; padding: 5px 12px; border: 1px solid var(--line-strong); border-radius: var(--radius); cursor: pointer; transition: background-color 150ms ease-out, border-color 150ms ease-out, color 150ms ease-out; background: var(--surface); color: var(--ink); } .ds-btn:hover { background: var(--hover); } .ds-btn:active { background: var(--line); } .ds-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }"
    },
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one primary action: sign in, unfreeze, confirm.",
      "html": "<button class=\"ds-btn-primary\">Sign in</button>",
      "css": ".ds-btn-primary { font-family: var(--font); font-size: 13px; font-weight: 500; line-height: 20px; padding: 5px 12px; border: 1px solid var(--line-strong); border-radius: var(--radius); cursor: pointer; transition: background-color 150ms ease-out, border-color 150ms ease-out, color 150ms ease-out; background: var(--accent); border-color: var(--accent); color: var(--accent-ink); } .ds-btn-primary:hover { background: var(--accent-hover); border-color: var(--accent-hover); } .ds-btn-primary:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }"
    },
    {
      "name": "Danger Button",
      "kind": "button",
      "refersTo": "button-danger",
      "description": "Freeze and its confirmation only.",
      "html": "<button class=\"ds-btn-danger\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"5\" y=\"10.5\" width=\"14\" height=\"10\" rx=\"2\"/><path d=\"M8 10.5V7.5a4 4 0 0 1 8 0v3\"/></svg>Freeze</button>",
      "css": ".ds-btn-danger { font-family: var(--font); font-size: 13px; font-weight: 500; line-height: 20px; padding: 5px 12px; border: 1px solid var(--line-strong); border-radius: var(--radius); cursor: pointer; transition: background-color 150ms ease-out, border-color 150ms ease-out, color 150ms ease-out; display: inline-flex; align-items: center; gap: 6px; background: var(--danger); border-color: var(--danger); color: var(--danger-ink); } .ds-btn-danger:hover { background: var(--danger-hover); border-color: var(--danger-hover); } .ds-btn-danger:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Low-emphasis toolbar actions such as Fit in the graph bar.",
      "html": "<button class=\"ds-btn-ghost\">Fit to screen</button>",
      "css": ".ds-btn-ghost { font-family: var(--font); font-size: 13px; font-weight: 500; line-height: 20px; padding: 5px 12px; border: 1px solid var(--line-strong); border-radius: var(--radius); cursor: pointer; transition: background-color 150ms ease-out, border-color 150ms ease-out, color 150ms ease-out; border-color: transparent; background: transparent; color: var(--ink-2); } .ds-btn-ghost:hover { background: var(--hover); color: var(--ink); } .ds-btn-ghost:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input-field",
      "description": "Labelled field for sign-in and the freeze reason.",
      "html": "<label class=\"ds-field\">Reason<input placeholder=\"Why freeze this account\" /></label>",
      "css": ".ds-field { display: grid; gap: 6px; font-family: var(--font); font-size: 13px; font-weight: 500; color: var(--ink-2); } .ds-field input { font: inherit; font-size: 14px; font-weight: 400; padding: 8px 10px; border: 1px solid var(--line-strong); border-radius: var(--radius); background: var(--surface); color: var(--ink); } .ds-field input::placeholder { color: var(--muted); } .ds-field input:focus-visible { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }"
    },
    {
      "name": "Account Search",
      "kind": "input",
      "refersTo": "search",
      "description": "Top-bar search with a leading icon; ring via focus-within.",
      "html": "<label class=\"ds-search\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"6.5\"/><path d=\"m20 20-4.4-4.4\"/></svg><input placeholder=\"Search account\" /></label>",
      "css": ".ds-search { display: flex; align-items: center; gap: 8px; height: 32px; padding: 0 10px; width: 240px; border: 1px solid var(--line-strong); border-radius: var(--radius); background: var(--surface); color: var(--muted); } .ds-search:focus-within { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); } .ds-search input { flex: 1; min-width: 0; border: none; background: none; font-family: var(--font); font-size: 13px; color: var(--ink); outline: none; }"
    },
    {
      "name": "Queue Views",
      "kind": "nav",
      "refersTo": "nav-item",
      "description": "Sidebar views with state dots and tabular counts.",
      "html": "<nav class=\"ds-views\"><button class=\"ds-view ds-active\"><i class=\"ds-vdot\"></i><span>All</span><b>48</b></button><button class=\"ds-view\"><i class=\"ds-vdot ds-freeze\"></i><span>Freeze tier</span><b>23</b></button><button class=\"ds-view\"><i class=\"ds-vdot ds-review\"></i><span>Review</span><b>25</b></button><button class=\"ds-view\"><i class=\"ds-vdot ds-frozen\"></i><span>Frozen</span><b>23</b></button></nav>",
      "css": ".ds-views { display: flex; flex-direction: column; gap: 2px; width: 216px; padding: 12px; background: var(--sidebar); } .ds-view { display: flex; align-items: center; gap: 10px; width: 100%; text-align: left; border: none; background: none; padding: 7px 8px; border-radius: var(--radius); font-family: var(--font); font-size: 13px; color: var(--ink-2); cursor: pointer; } .ds-view span { flex: 1; } .ds-view b { font-weight: 500; font-size: 12px; color: var(--muted); font-variant-numeric: tabular-nums; } .ds-view:hover { background: var(--hover); color: var(--ink); } .ds-view:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; } .ds-view.ds-active { background: var(--surface); color: var(--ink); font-weight: 600; box-shadow: 0 0 0 1px var(--line); } .ds-vdot { width: 8px; height: 8px; border-radius: 50%; background: var(--line-strong); } .ds-vdot.ds-freeze { background: var(--danger); } .ds-vdot.ds-review { background: var(--warn-dot); } .ds-vdot.ds-frozen { background: var(--frozen); }"
    },
    {
      "name": "Tier and Status Pills",
      "kind": "chip",
      "refersTo": "tier-freeze",
      "description": "Soft-tint pills; FROZEN always carries the lock.",
      "html": "<span class=\"ds-pill ds-freeze\">Freeze tier</span> <span class=\"ds-pill ds-review\">Review</span> <span class=\"ds-pill ds-active\"><i class=\"ds-sdot\"></i>Active</span> <span class=\"ds-pill ds-frozen\"><svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"5\" y=\"10.5\" width=\"14\" height=\"10\" rx=\"2\"/><path d=\"M8 10.5V7.5a4 4 0 0 1 8 0v3\"/></svg>Frozen</span>",
      "css": ".ds-pill { display: inline-flex; align-items: center; gap: 6px; font-family: var(--font); font-size: 12px; font-weight: 500; line-height: 18px; padding: 1px 8px; border-radius: 999px; white-space: nowrap; } .ds-freeze { background: var(--danger-soft); color: var(--danger); } .ds-review { background: var(--warn-soft); color: var(--warn); } .ds-active { background: var(--ok-soft); color: var(--ok); } .ds-frozen { background: var(--frozen-soft); color: var(--frozen); } .ds-sdot { width: 6px; height: 6px; border-radius: 50%; background: currentColor; }"
    },
    {
      "name": "Signal Chip",
      "kind": "chip",
      "refersTo": "chip-signal",
      "description": "A fired rule, with its plain-language reason as a title.",
      "html": "<span class=\"ds-chip\" title=\"90% of an incoming amount left within 2 h\">pass_through</span> <span class=\"ds-chip ds-graph\" title=\"Received from a suspect and passed it on\">from_suspect</span>",
      "css": ".ds-chip { display: inline-block; font-family: var(--font); font-size: 12px; line-height: 18px; padding: 1px 7px; border: 1px solid var(--line); border-radius: 4px; background: var(--canvas); color: var(--ink-2); cursor: help; } .ds-chip.ds-graph { border-color: color-mix(in srgb, var(--danger) 45%, var(--line)); }"
    },
    {
      "name": "Overview Strip",
      "kind": "card",
      "refersTo": "panel",
      "description": "One bordered surface divided into stat cells; no separate cards.",
      "html": "<div class=\"ds-overview\"><div class=\"ds-stat\"><span>Suspects</span><b>48</b></div><div class=\"ds-stat ds-f\"><span>Freeze tier</span><b>23</b></div><div class=\"ds-stat ds-r\"><span>Review</span><b>25</b></div></div>",
      "css": ".ds-overview { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); font-family: var(--font); } .ds-stat { padding: 12px 16px; display: flex; flex-direction: column; gap: 2px; border-left: 1px solid var(--line); } .ds-stat:first-child { border-left: none; } .ds-stat span { font-size: 12px; font-weight: 500; color: var(--muted); } .ds-stat b { font-size: 24px; font-weight: 600; line-height: 1.25; letter-spacing: -0.01em; font-variant-numeric: tabular-nums; color: var(--ink); } .ds-f b { color: var(--danger); } .ds-r b { color: var(--warn); }"
    }
  ],
  "narrative": {
    "northStar": "The Case Ledger",
    "overview": "A fraud investigator's working console in the fintech category standard, built to the craft level of Stripe Dashboard and fraud consoles such as Sardine and Unit21. It plays the category straight, with no themed costume. The screen holds a case queue, a reason for every flag and the money's path. Everything else stays quiet so that those three read first.\n\nThe world is restrained and dense. A cool canvas carries white working surfaces, and a second, cooler neutral layer holds the sidebar. Text is navy ink. One indigo accent marks primary action, selection and focus. Colour appears only where it carries state: red for the freeze tier, amber for review, green for active, and slate with a lock for frozen. Light and dark are both first-class and follow the system setting (`prefers-color-scheme`). There is no toggle.",
    "keyCharacteristics": [
      "One indigo accent; every other hue is a state.",
      "1px borders and tonal layers carry structure. Shadows appear only on floating layers.",
      "One gently rounded corner (6px) across controls and surfaces.",
      "One sans family (Inter for Latin, Noto Sans Thai for Thai) with tabular numerals for every figure.",
      "A compact type scale (12/13/14/16/20/24) with no display size.",
      "Light and dark token sets with identical roles."
    ],
    "rules": [
      {
        "name": "The One Accent Rule",
        "body": "Indigo is used only for primary action, selection and focus. It never marks a state, a category or decoration.",
        "section": "colors"
      },
      {
        "name": "The State-Carries-Meaning Rule",
        "body": "Red, amber, green and slate appear only where they encode tier, status or money direction; red also marks destructive actions (freeze, sign-out) and errors. Each state comes as a solid for text or marks and a soft tint for the pill behind it.",
        "section": "colors"
      },
      {
        "name": "The Twin Theme Rule",
        "body": "Every colour token has a dark counterpart with the same role. In dark mode the accent and danger buttons take dark text. Never add a colour that exists in only one scheme.",
        "section": "colors"
      },
      {
        "name": "The Tabular Figures Rule",
        "body": "Every amount, count, account number and timestamp uses `font-variant-numeric: tabular-nums` so columns align.",
        "section": "typography"
      },
      {
        "name": "The Thai Leading Rule",
        "body": "Thai text (`:lang(th)`) gets line-height 1.65 instead of 1.55, so stacked vowels and tone marks never collide.",
        "section": "typography"
      },
      {
        "name": "The No Display Rule",
        "body": "The scale stops at 24px. This is a working console, and no hero type belongs in it.",
        "section": "typography"
      },
      {
        "name": "The Floating-Only Shadow Rule",
        "body": "Panels, tables and cards sit flat on borders. Only layers above the page (menu, dialog, toast, login card) cast the soft float shadow. Hard or offset-only shadows never appear.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the indigo accent only for primary action, selection and focus.",
      "Do pair every state colour with its soft tint, and pair FROZEN with the lock icon.",
      "Do set every figure in tabular numerals, and give Thai text its 1.65 line height.",
      "Do define every new colour in both the light and the dark token set.",
      "Do read theme colours from CSS variables at mount for anything drawn on canvas, rather than hard-coding hex.",
      "Do keep the 6px radius and 1px borders on new controls and surfaces.",
      "Do draw new icons on the 24px grid with a 1.5 round-capped stroke in currentColor.",
      "Do honour `prefers-reduced-motion`: animations and transitions switch off."
    ],
    "donts": [
      "Don't put shadows on panels, tables or cards. The float shadow is for menus, dialogs, toasts and the login card only.",
      "Don't add a second accent hue, or use a state colour for decoration.",
      "Don't add uppercase tracked labels or kicker lines above headings. Labels are 12px/500 sentence case.",
      "Don't set type above 24px.",
      "Don't use emoji or text glyphs as icons. Use the stroke set.",
      "Don't add a manual theme toggle. The scheme follows the system setting."
    ]
  }
}
